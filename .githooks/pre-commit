#!/bin/bash

# Refuse commits that touch vendored directories unless --no-verify is used.
# Written for bash 3 (macOS /bin/bash has no associative arrays): two parallel
# lists, a path prefix and the message shown for it.

PREFIXES=(
  "src/external/rawspeed/"
  "src/external/OpenCL/"
  "src/external/libxcf/"
  "src/external/whereami/"
  "src/tests/integration/"
)
MESSAGES=(
  "use --no-verify to change rawspeed"
  "use --no-verify to change OpenCL"
  "use --no-verify to change libxcf"
  "use --no-verify to change whereami"
  "use --no-verify to change integration"
)

# Added (A), copied (C) and modified (M) staged files only.
errors=()
while IFS= read -r file; do
  for i in "${!PREFIXES[@]}"; do
    case "$file" in
      "${PREFIXES[$i]}"*) errors+=("${MESSAGES[$i]}") ;;
    esac
  done
done < <(git diff --staged --name-only --diff-filter=ACM --no-color)

# Print each message once.
if [ ${#errors[@]} -ne 0 ]; then
  printf '%s\n' "${errors[@]}" | sort -u | while IFS= read -r error; do
    echo -e "\033[1;31m${error}\033[0m"
  done
  exit 1
fi
